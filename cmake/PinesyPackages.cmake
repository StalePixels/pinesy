# Tells the user what to install when the packages an app needs are missing.
#
#   pinesy_missing_message(<out> <app> <entries>...)
#     Each entry is "<what>|<file>|<version>": what the app needs, the file
#     its CMake or pkg-config lookup reads, and the minimum version. For
#     each entry the package of this OS that has the file is looked up,
#     with the version the OS has. <out> gets the message: what to
#     install, what is too old on this OS, and what this OS does not have.
#     PINESY_TOO_OLD, set by the caller, lists packages that are installed
#     but too old; it is added to the message.
#
# The lookup uses the OS's own package manager where it can search by
# file: dnf, pacman (with its file database) or apt-file. Debian, Ubuntu
# and the systems based on them, without apt-file, use the file search of
# packages.debian.org or packages.ubuntu.com.

function(_pinesy_os_release key out)
	set(${out} "" PARENT_SCOPE)
	if(EXISTS /etc/os-release)
		file(STRINGS /etc/os-release _lines REGEX "^${key}=")
		if(_lines)
			list(GET _lines 0 _line)
			string(REGEX REPLACE "^${key}=\"?([^\"]*)\"?$" "\\1" _value "${_line}")
			set(${out} "${_value}" PARENT_SCOPE)
		endif()
	endif()
endfunction()

# "1:6.4.2+dfsg-21" -> "6.4.2"
function(_pinesy_plain_version version out)
	string(REGEX REPLACE "^[0-9]+:" "" version "${version}")
	string(REGEX MATCH "^[0-9]+(\\.[0-9]+)*" version "${version}")
	set(${out} "${version}" PARENT_SCOPE)
endfunction()

function(_pinesy_download url out)
	set(${out} "" PARENT_SCOPE)
	set(_page "${CMAKE_BINARY_DIR}/pinesy-package-search.html")
	foreach(_try 1 2)
		file(DOWNLOAD "${url}" "${_page}" TIMEOUT 30 STATUS _status)
		list(GET _status 0 _code)
		if(_code EQUAL 0)
			file(READ "${_page}" _html)
			file(REMOVE "${_page}")
			set(${out} "${_html}" PARENT_SCOPE)
			return()
		endif()
	endforeach()
	file(REMOVE "${_page}")
endfunction()

# Sets <prefix>_STATE to FOUND, NONE (the OS has no package with the file)
# or UNKNOWN (the search did not work), and <prefix>_PACKAGE and
# <prefix>_VERSION when FOUND.
function(_pinesy_lookup file prefix)
	set(_state UNKNOWN)
	set(_package "")
	set(_version "")

	find_program(_PINESY_DNF dnf)
	find_program(_PINESY_PACMAN pacman)
	find_program(_PINESY_APT_FILE apt-file)
	find_program(_PINESY_APT_CACHE apt-cache)
	_pinesy_os_release(ID _id)
	_pinesy_os_release(ID_LIKE _id_like)

	if(_PINESY_DNF)
		execute_process(COMMAND ${_PINESY_DNF} -q provides "*/${file}"
			RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_QUIET TIMEOUT 180)
		# "kf6-ki18n-devel-6.8.0-1.fc41.x86_64 : ..."
		if(_output MATCHES "(^|\n)([A-Za-z0-9_.+-]+)-([0-9][^-]*)-[^- ]+ :")
			set(_state FOUND)
			set(_package "${CMAKE_MATCH_2}")
			set(_version "${CMAKE_MATCH_3}")
		elseif(_result EQUAL 0 OR _output STREQUAL "")
			set(_state NONE)
		endif()
	elseif(_PINESY_PACMAN)
		execute_process(COMMAND ${_PINESY_PACMAN} -F "${file}"
			OUTPUT_VARIABLE _output ERROR_VARIABLE _error TIMEOUT 60)
		# "extra/ki18n 6.8.0-1"
		if(_output MATCHES "^[^/\n]+/([^ \n]+) ([^ \n]+)")
			set(_state FOUND)
			set(_package "${CMAKE_MATCH_1}")
			set(_version "${CMAKE_MATCH_2}")
		elseif(NOT _error MATCHES "database")
			set(_state NONE)
		endif()
	elseif(_PINESY_APT_FILE AND _PINESY_APT_CACHE)
		execute_process(COMMAND ${_PINESY_APT_FILE} -l search "/${file}"
			RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_QUIET TIMEOUT 180)
		string(REGEX MATCH "^[^\n]+" _package "${_output}")
		if(_package)
			execute_process(COMMAND ${_PINESY_APT_CACHE} policy "${_package}"
				OUTPUT_VARIABLE _policy ERROR_QUIET TIMEOUT 60)
			if(_policy MATCHES "Candidate: ([^\n]+)")
				set(_state FOUND)
				set(_version "${CMAKE_MATCH_1}")
			endif()
		elseif(_result EQUAL 0 OR _result EQUAL 1)
			set(_state NONE)
		endif()
	else()
		set(_host "")
		if(_id STREQUAL "ubuntu" OR _id_like MATCHES "ubuntu")
			set(_host packages.ubuntu.com)
			_pinesy_os_release(UBUNTU_CODENAME _suite)
			if(NOT _suite)
				_pinesy_os_release(VERSION_CODENAME _suite)
			endif()
		elseif(_id STREQUAL "debian" OR _id_like MATCHES "debian")
			set(_host packages.debian.org)
			_pinesy_os_release(VERSION_CODENAME _suite)
		endif()
		if(_host AND _suite)
			_pinesy_download("https://${_host}/search?searchon=contents&keywords=${file}&mode=exactfilename&suite=${_suite}&arch=any" _html)
			if(_html MATCHES "class=\"keyword\">${file}</span></td>[ \t\r\n]*<td>[ \t\r\n]*<a href=\"/${_suite}/([^\"]+)\"")
				set(_package "${CMAKE_MATCH_1}")
				_pinesy_download("https://${_host}/${_suite}/${_package}" _page)
				if(_page MATCHES "<h1>Package: ${_package} \\(([^)]+)\\)")
					set(_state FOUND)
					set(_version "${CMAKE_MATCH_1}")
				endif()
			elseif(_html MATCHES "Sorry, your search gave no results")
				set(_state NONE)
			endif()
		endif()
	endif()

	_pinesy_plain_version("${_version}" _version)
	set(${prefix}_STATE "${_state}" PARENT_SCOPE)
	set(${prefix}_PACKAGE "${_package}" PARENT_SCOPE)
	set(${prefix}_VERSION "${_version}" PARENT_SCOPE)
endfunction()

function(pinesy_missing_message out app)
	_pinesy_os_release(PRETTY_NAME _os)
	if(NOT _os)
		set(_os "this OS")
	endif()

	set(_install "")
	set(_packages "")
	set(_too_old "")
	set(_absent "")
	set(_unknown "")
	set(_done "")
	foreach(_entry IN LISTS ARGN)
		string(REPLACE "|" ";" _entry "${_entry}")
		list(GET _entry 0 _what)
		list(GET _entry 1 _file)
		list(GET _entry 2 _needed)
		# one line for each thing, however many of its files are missing
		if(_what IN_LIST _done)
			continue()
		endif()
		list(APPEND _done "${_what}")

		_pinesy_lookup("${_file}" _found)
		if(_found_STATE STREQUAL "FOUND")
			if(_found_VERSION AND _found_VERSION VERSION_LESS _needed)
				list(APPEND _too_old "${_what}: ${_found_PACKAGE} is ${_found_VERSION}, ${_needed} or later is needed")
			else()
				list(APPEND _install "${_what}: ${_found_PACKAGE}")
				list(APPEND _packages "${_found_PACKAGE}")
			endif()
		elseif(_found_STATE STREQUAL "NONE")
			list(APPEND _absent "${_what}")
		else()
			list(APPEND _unknown "${_what}: the package with the file ${_file}")
		endif()
	endforeach()

	set(_message "")
	if(PINESY_TOO_OLD)
		list(APPEND _too_old ${PINESY_TOO_OLD})
	endif()
	if(_too_old)
		list(JOIN _too_old "\n  " _text)
		string(APPEND _message "Too old on ${_os}:\n  ${_text}\n\n")
	endif()
	if(_absent)
		list(JOIN _absent "\n  " _text)
		string(APPEND _message "Not available on ${_os}:\n  ${_text}\n\n")
	endif()
	if(_too_old OR _absent)
		string(APPEND _message "${_os} cannot build the ${app}.\n")
	else()
		if(_install)
			list(JOIN _install "\n  " _text)
			list(JOIN _packages " " _list)
			if(_PINESY_DNF)
				set(_command "sudo dnf install ${_list}")
			elseif(_PINESY_PACMAN)
				set(_command "sudo pacman -S ${_list}")
			else()
				set(_command "sudo apt install ${_list}")
			endif()
			string(APPEND _message "Install these packages:\n  ${_text}\n\n  ${_command}\n")
		endif()
		if(_unknown)
			list(JOIN _unknown "\n  " _text)
			string(APPEND _message "Also install these. The packages of ${_os} could not be searched, so find the package that has each file:\n  ${_text}\n")
		endif()
	endif()
	set(${out} "${_message}" PARENT_SCOPE)
endfunction()
