[submodule "qemu"]
	path = qemu
	url = https://github.com/StalePixels/qemu.git
	branch = pinesy
[submodule "mame"]
	path = mame
	url = https://github.com/StalePixels/mame.git
	branch = pinesy
[submodule "vendor/rpi-utils"]
	path = vendor/rpi-utils
	url = https://github.com/raspberrypi/utils.git
[submodule "vendor/gdb"]
	path = vendor/gdb
	url = https://sourceware.org/git/binutils-gdb.git
	shallow = true
	update = none
